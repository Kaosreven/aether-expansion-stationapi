{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Meefy",
    "Kaosreven"
  ],
  "contributors": [
    "mine_diver",
    "Calmilamsy",
    "LukeIsStuff",
    "AONK",
    "Kingbdogz",
    "ShockAh",
    "Kodaichi",
    "Flan",
    "303"
  ],
  "contact": {
    "sources": "${mod_source}"
  },

